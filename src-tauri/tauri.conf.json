{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parugram",
  "version": "0.1.0",
  "identifier": "com.exie.parugram",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Parugram",
        "decorations": false,
        "width": 1160,
        "height": 760,
        "minWidth": 320,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": { "target/tdlib-runtime/*.dll": "./" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
